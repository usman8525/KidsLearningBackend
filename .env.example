# Copy to server/.env and fill in. Never commit the real file.
PORT=4000

# Azure Speech resource (Azure portal → Speech service → Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_TTS_VOICE=en-US-AnaNeural

# Optional — only used for a friendly retry tip. Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pass/fail thresholds (Azure scores 0-100, confidence 0-1)
PRONUNCIATION_ACCURACY_THRESHOLD=75
PRONUNCIATION_WORD_THRESHOLD=70
PRONUNCIATION_COMPLETENESS_THRESHOLD=80
PRONUNCIATION_MIN_CONFIDENCE=0.5
PRONUNCIATION_PHONEME_THRESHOLD=50
PRONUNCIATION_SUBSTITUTION_MARGIN=10
PRONUNCIATION_SUBSTITUTION_MAX_ACCURACY=80
PRONUNCIATION_REQUIRE_FREE_RECOGNITION=true
